#!/usr/bin/env node
// Finishes an edit as the wiki's AGENTS.md says, from the wiki root (the folder it runs in): fills the
// generated regions, stamps the given pages' sources at the pins, and checks them. It stops at the
// first tool that fails, with that tool's code, so it exits 0 only once each tool succeeded and the
// check reports no errors.
// Usage: finish <pins file> <page>…
import { spawnSync } from 'node:child_process'

const [pinsFile, ...pages] = process.argv.slice(2)
if (!pinsFile || !pages.length) {
  console.error('usage: finish <pins file> <page>…')
  process.exit(2)
}

const tool = (name, args) => {
  console.log(`$ node _wiki/tools/${name}.mjs ${args.join(' ')}`)
  return spawnSync(process.execPath, [`_wiki/tools/${name}.mjs`, ...args], { stdio: 'inherit' }).status ?? 1
}
for (const [name, args] of [
  ['regions', []],
  ['stamp', [pinsFile, ...pages]],
  ['check', [...pages, '--pins', pinsFile]],
]) {
  const code = tool(name, args)
  if (code !== 0) {
    if (name !== 'check') console.error(`${name} failed, so the pages weren't ${name === 'regions' ? 'stamped or checked' : 'checked'}`)
    process.exit(code)
  }
}
