# Copy to .env (never committed) and fill in.

# Your git author emails, comma-separated. Findings on commits by these emails are marked as yours.
SARANSH_GIT_EMAILS=

# The Discord Step is skipped until all three are set.
# The read-only bot's token, never your own account's. The bot needs View Channel and Read Message
# History on the watched channels, and the Message Content intent turned on in the Developer Portal.
DISCORD_BOT_TOKEN=
# The channels to read, comma-separated: server channels, with their threads, and DMs with the bot.
# A bot can't list its own DMs, so give each DM's channel ID. Your own DMs are never reachable.
DISCORD_CHANNEL_IDS=
# Whether a DM with the bot among the channels is read (true, the default) or fails the Step (false).
DISCORD_READ_DMS=true
# Your Discord user ID, so messages that mention you are flagged.
DISCORD_USER_ID=

# Your own checkout of the org wiki, such as ~/Saransh/inshorts. The Docs Step is skipped until it is set.
# The Docs Agent works in its own worktree of it, on the agents/docs branch, and commits there under the
# git identity this checkout uses. It never touches the checkout itself, and never pushes or merges.
WIKI_FOLDER=
