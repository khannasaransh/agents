# Copy to .env (never committed) and fill in.

# Your git author emails, comma-separated. Findings on commits by these emails are marked as yours.
SARANSH_GIT_EMAILS=

# The Discord Step is skipped until all three are set.
# The read-only bot's token, never your own account's. The bot needs View Channel and Read Message
# History on the watched channels, and the Message Content intent turned on in the Developer Portal.
DISCORD_BOT_TOKEN=
# The channels to read, comma-separated: server channels, with their threads, and DMs with the bot.
# A bot can't list its own DMs, so give each DM's channel ID. Your own DMs are never reachable.
DISCORD_CHANNEL_IDS=
# Whether a DM with the bot among the channels is read (true, the default) or fails the Step (false).
DISCORD_READ_DMS=true
# Your Discord user ID, the number, not your username, so messages that mention you are flagged. With
# Developer Mode on (Settings, Advanced), right-click your name and Copy User ID.
DISCORD_USER_ID=
# The channel where each sprint's task list is posted. Its latest sprint post is read every Run,
# whenever it was posted, for the PM Agent's task status report. No report while it is empty.
# Unless DISCORD_READ_DMS=false, the report also reads the bot's DMs with you and with each assignee:
# a bot can't read your own DMs, so forward it the ones that say how a task stands.
DISCORD_SPRINT_CHANNEL_ID=

# Your own checkout of the org wiki, such as ~/Saransh/inshorts. The Docs Step is skipped until it is set.
# The Docs Agent works in its own worktree of it, on the agents/docs branch, and commits there under the
# git identity this checkout uses. It never touches the checkout itself and never pushes. It merges main
# into the docs branch, but never the docs branch into main: that's yours to do once you've reviewed it.
WIKI_FOLDER=

# ash_new's folder, which the stocks Pipeline reaches only through its `pd` command. Defaults to
# backend/portfolio-dashboard in the folder holding this repo. `pd` is the first on PATH, else the one in
# ash_new's own environment (.venv) there.
ASH_NEW_FOLDER=
